# Required
COMPOSE_PROJECT_NAME=ai-anti-spam
BOT_TOKEN=123456789:replace-with-your-telegram-bot-token

# Optional admin notifications for captcha bans/timeouts. 0 disables it.
ADMIN_CHAT_ID=0

# Bot mode
DEBUG=False
USE_WEBHOOK=False
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace-with-random-secret

# CockroachDB Cloud
COCKROACHDB_URL=cockroachdb+asyncpg://USER:PASSWORD@HOST:26257/defaultdb?ssl=require

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
